# .gitignore for brain repo

# ------------------------------------------------------------------
# Secrets & env
# ------------------------------------------------------------------
# Never commit real environment files or secrets. Keep .env.example tracked.
brain.env
.env
*.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ------------------------------------------------------------------
# OS / editor / tooling
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/
*.swp
*~

# Python
__pycache__/
*.pyc

# Node
node_modules/
**/node_modules/

# Logs and temporary files
logs/
.logs/
*.log
*.tmp
tmp/
bin/
desktop/dist/
desktop/src-tauri/target/

# Local Brain state and generated scratch files
.brain/
.brain-state/
skill-context.md
stack-tags.txt
telemetry.ndjson
doctor.sh
README.md.bak
EXECUTION_PLAN.md
REFACTOR_PLAN.md
REFACTORING_SUMMARY.md
BRAIN_CLI_REFERENCE.txt
.cursorrules
.windsurfrules

# ------------------------------------------------------------------
# Generated and runtime data (do not commit heavy or reproducible artifacts)
# ------------------------------------------------------------------
# Docker / compose runtime state and generated data
ai-local/open_webui_data/
ai-local/mcp_data/
ai-local/model_runner_data/
qdrant_data/
mcp_memory_data/
open_webui_data/
model_runner_data/
mcp_data/
memory/chunks/

# Test run outputs and reports (generated)
tests/results/
tests/fixtures/

# Compiled/generated rule artifacts and adapters
rules/compiled/
adapters/**/CLAUDE.md
adapters/**/.cursorrules
adapters/**/.windsurfrules

# Generated MCP gateway artifacts
mcp/gateway/node_modules/

# Misc
docker-compose.override.yml
*.tgz
*.tar
brain-testor
test*.out

# Keep important docs and source tracked (README, ARCHITECTURE.md, scripts/, bin/)



