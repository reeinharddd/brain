{
  "//": "Docker mode - Hybrid stable MCP setup without SSE bridge dependency.",
  "//2": "Switch to this with: ln -sf ~/.brain/adapters/claude-code/settings.docker.json ~/.claude/settings.json",
  "mcpServers": {
    "memory": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-memory", "/home/reeinharrrd/.brain/memory"]
    },
    "filesystem": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-filesystem", "/home/reeinharrrd"]
    },
    "sequential-thinking": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "command": "bunx",
      "args": ["@upstash/context7-mcp@latest"]
    },
    "github": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-github"]
    }
  },
  "permissions": {
    "allow": ["Bash", "Read", "Write", "WebFetch"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "brain",
            "args": ["hooks", "pre-tool-use", "block-env-writes"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "brain",
            "args": ["hooks", "post-tool-use", "run-linter"]
          }
        ]
      }
    ]
  }
}