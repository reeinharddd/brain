{
  "apiVersion": "brain/v1",
  "kind": "mcp",
  "id": "brain-mcp-server",
  "displayName": "Brain Mcp Server",
  "description": "MCP package artifact for Brain Mcp Server.",
  "scope": "workspace",
  "owner": "user:brain",
  "visibility": "workspace",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/mcps/brain-mcp-server"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "restricted"
    }
  },
  "content": {
    "entrypoint": "artifacts/mcps/brain-mcp-server/README.md",
    "files": [
      "artifacts/mcps/brain-mcp-server/README.md"
    ]
  },
  "mcp": {
    "transport": "stdio",
    "profiles": [
      "standard",
      "full"
    ],
    "requiredEnv": []
  }
}
