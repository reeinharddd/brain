{
  "//": "Full MCP profile — all MCPs. Use for heavy sessions only.",
  "profile": "full",
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "memory": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-memory", "/home/reeinharrrd/.brain/memory"]
    },
    "filesystem": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-filesystem", "/home/reeinharrrd"]
    },
    "context7": {
      "command": "bunx",
      "args": ["@upstash/context7-mcp@latest"]
    },
    "sequential-thinking": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"]
    },
    "github": {
      "command": "bunx",
      "args": ["@modelcontextprotocol/server-github"]
    },
    "brain-rules": {
      "command": "brain",
      "args": ["mcp", "serve"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  }
}
