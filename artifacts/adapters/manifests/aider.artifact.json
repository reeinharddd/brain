{
  "apiVersion": "brain/v1",
  "kind": "adapter",
  "id": "aider",
  "displayName": "Aider",
  "description": "Adapter artifact for Aider.",
  "scope": "workspace",
  "owner": "user:brain",
  "visibility": "workspace",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/adapters/aider"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "artifacts/adapters/aider/system-prompt.md",
    "files": [
      "artifacts/adapters/aider/system-prompt.md"
    ]
  },
  "adapter": {
    "target": "aider",
    "format": "markdown",
    "projection": {
      "kind": "adapter"
    }
  }
}
