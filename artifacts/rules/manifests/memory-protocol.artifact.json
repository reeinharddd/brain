{
  "apiVersion": "brain/v1",
  "kind": "rule",
  "id": "memory-protocol",
  "displayName": "Memory Protocol",
  "description": "Rule artifact for memory/protocol.md.",
  "scope": "organization",
  "owner": "brain:system",
  "visibility": "organization",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/rules/memory/protocol.md"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "reviewStatus": "approved",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "memory/protocol.md",
    "files": [
      "memory/protocol.md"
    ]
  },
  "rule": {
    "priority": 600,
    "enforcement": "required",
    "mergeStrategy": "compose"
  }
}
