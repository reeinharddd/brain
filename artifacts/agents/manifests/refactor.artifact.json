{
  "apiVersion": "brain/v1",
  "kind": "agent",
  "id": "refactor",
  "displayName": "Refactor",
  "description": "Agent artifact for refactor.",
  "scope": "user",
  "owner": "brain:system",
  "visibility": "private",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/agents/refactor.md"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "reviewStatus": "approved",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "refactor.md",
    "files": [
      "refactor.md"
    ]
  },
  "agent": {
    "role": "refactor",
    "modelPolicy": {
      "preferredTier": "powerful",
      "minimumTier": "standard"
    }
  }
}
