{
  "apiVersion": "brain/v1",
  "kind": "agent",
  "id": "guardian",
  "displayName": "Guardian",
  "description": "Agent artifact for guardian.",
  "scope": "user",
  "owner": "brain:system",
  "visibility": "private",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/agents/guardian.md"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "reviewStatus": "approved",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "guardian.md",
    "files": [
      "guardian.md"
    ]
  },
  "agent": {
    "role": "guardian",
    "modelPolicy": {
      "preferredTier": "powerful",
      "minimumTier": "standard"
    }
  }
}
