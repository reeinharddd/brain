{
  "apiVersion": "brain/v1",
  "kind": "command",
  "id": "review",
  "displayName": "Review",
  "description": "Command artifact for /review.",
  "scope": "user",
  "owner": "brain:system",
  "visibility": "private",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/commands/review.md"
  },
  "sync": {
    "mode": "hybrid",
    "cloudEnabled": true
  },
  "security": {
    "trust": "verified",
    "reviewStatus": "approved",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "review.md",
    "files": [
      "review.md"
    ]
  },
  "command": {
    "trigger": "/review",
    "autoInvokePolicy": "manual",
    "outputContract": {
      "format": "markdown"
    }
  }
}
