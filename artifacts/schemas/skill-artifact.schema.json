{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.dev/schemas/skill-artifact.schema.json",
  "title": "Brain Skill Artifact",
  "allOf": [
    {
      "$ref": "./artifact-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "skill"
        },
        "skill": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "category",
            "compatibility"
          ],
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "compatibility": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "minCapabilityTier": {
                  "type": "string"
                },
                "preferredCapabilityTier": {
                  "type": "string"
                }
              }
            },
            "scripts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "skill"
      ]
    }
  ]
}
