{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.dev/schemas/artifact-envelope.schema.json",
  "title": "Brain Artifact Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "displayName",
    "scope",
    "owner",
    "visibility",
    "lifecycle",
    "source",
    "sync",
    "security",
    "content"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "brain/v1"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform",
        "organization",
        "team",
        "user",
        "workspace",
        "project",
        "session"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "organization",
        "public"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "disabled",
            "deprecated",
            "blocked",
            "archived"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "uri"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "manual",
            "local",
            "cloud",
            "git",
            "registry",
            "npm",
            "oci",
            "link"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "cloud",
            "hybrid"
          ]
        },
        "cloudEnabled": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "trust",
        "permissions"
      ],
      "properties": {
        "trust": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "blocked"
          ]
        },
        "reviewStatus": {
          "type": "string"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fs": {
              "type": "string",
              "enum": [
                "none",
                "read",
                "write",
                "read-write"
              ]
            },
            "net": {
              "type": "string",
              "enum": [
                "none",
                "restricted",
                "allow"
              ]
            },
            "exec": {
              "type": "string",
              "enum": [
                "none",
                "restricted",
                "allow"
              ]
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
