{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.dev/schemas/agent-artifact.schema.json",
  "title": "Brain Agent Artifact",
  "allOf": [
    {
      "$ref": "https://brain.dev/schemas/artifact-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "agent"
        },
        "agent": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "role",
            "modelPolicy"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "modelPolicy": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "preferredTier": {
                  "type": "string"
                },
                "minimumTier": {
                  "type": "string"
                }
              }
            },
            "delegation": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "required": [
        "agent"
      ]
    }
  ]
}
