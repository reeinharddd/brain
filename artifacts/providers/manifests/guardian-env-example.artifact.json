{
  "apiVersion": "brain/v1",
  "kind": "adapter",
  "id": "guardian-env-example",
  "displayName": "Guardian Env Example",
  "description": "Provider configuration artifact for Guardian Env.",
  "scope": "platform",
  "owner": "user:brain",
  "visibility": "private",
  "lifecycle": {
    "state": "active"
  },
  "source": {
    "type": "local",
    "uri": "local://artifacts/providers/guardian.env.example"
  },
  "sync": {
    "mode": "local"
  },
  "security": {
    "trust": "verified",
    "permissions": {
      "fs": "read",
      "net": "none",
      "exec": "none"
    }
  },
  "content": {
    "entrypoint": "artifacts/providers/guardian.env.example",
    "files": [
      "artifacts/providers/guardian.env.example"
    ]
  },
  "adapter": {
    "target": "guardian-env-example",
    "format": "yaml",
    "projection": {
      "kind": "operational"
    }
  }
}
