{
  "apiVersion": "brain/v1",
  "kind": "policy",
  "id": "policy-baseline",
  "displayName": "Policy Baseline",
  "description": "Baseline policy evaluation and approval model for Brain artifacts and execution.",
  "scope": "organization",
  "owner": "system:brain",
  "visibility": "organization",
  "lifecycle": {"state": "active"},
  "source": {"type": "manual", "uri": "artifacts/policy/policy-baseline.json"},
  "sync": {"mode": "cloud", "cloudEnabled": true},
  "security": {"trust": "verified", "permissions": {"fs": "read", "net": "none", "exec": "none"}},
  "content": {"entrypoint": "artifacts/policy/policy-baseline.json", "files": ["artifacts/policy/policy-baseline.json"]},
  "labels": ["policy", "security", "governance"],
  "policy": {
    "engine": "hybrid",
    "defaultEffect": "deny-by-default",
    "enforcementMode": "mixed"
  }
}
