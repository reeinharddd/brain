# ═══════════════════════════════════════════════════════════
#  brain/docker/.env.example
#  Copy to: ~/.brain/docker/.env  (never commit .env)
#  Used by daemon to orchestrate persistent services
# ═══════════════════════════════════════════════════════════

# ── DAEMON ORCHESTRATION ─────────────────────────────────────
# These are read by daemon at startup. Set in your shell profile
# or in this .env file if you want docker-specific overrides.
#
# BRAIN_ROOT=/path/to/your/.brain
# DAEMON_PORT=9090

# ── QDRANT CONFIGURATION ─────────────────────────────────────
# Optional: API key for Qdrant (leave empty for no auth in dev)
# QDRANT_API_KEY=

# ── OLLAMA CONFIGURATION ─────────────────────────────────────
# Uncomment ollama service in docker-compose.yml to enable local inference
# OLLAMA_HOST=0.0.0.0:11434

# ── HOST CONFIGURATION ───────────────────────────────────────
# Your home directory (used for volume binds)
HOST_HOME=/home/your-username

# Container user UID/GID (should match your host user)
HOST_UID=1000
HOST_GID=1000

# ── LLM PROVIDER KEYS (set in shell profile, not here) ───────
# export OPENAI_API_KEY=sk-...
# export ANTHROPIC_API_KEY=sk-ant-...
# export GITHUB_TOKEN=ghp_...
# export GOOGLE_API_KEY=...
#
# daemon reads these from environment at startup and routes
# requests based on providers.yml task routing configuration.
