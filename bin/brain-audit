#!/bin/bash
# ===========================================================
#  brain-audit - Code quality audit for Brain Repo
# ===========================================================

set -euo pipefail

BRAIN_DIR="${BRAIN_DIR:-$HOME/.brain}"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

ERRORS=0
WARNINGS=0

log_error() { echo -e "${RED}[ERR]${RESET} $1"; ((ERRORS++)); }
log_warn() { echo -e "${YELLOW}[WARN]${RESET} $1"; ((WARNINGS++)); }
log_ok() { echo -e "${GREEN}[OK]${RESET} $1"; }
log_info() { echo -e "${BLUE}[INFO]${RESET} $1"; }

section() { echo -e "\n${BOLD}$1${RESET}"; }

echo -e "${BOLD}Brain Repo Code Audit${RESET}\n"

# Check 1: Hardcoded paths
section "1. Hardcoded Paths Check"
found=0
while IFS= read -r -d '' file; do
    if grep -l "/home/\|/Users/\|/root/" "$file" 2>/dev/null | grep -qv "Binary"; then
        matches=$(grep -n "/home/\|/Users/\|/root/" "$file" 2>/dev/null | head -3)
        if [ -n "$matches" ]; then
            log_warn "Hardcoded paths in: $file"
            echo "$matches" | head -2
            found=1
        fi
    fi
done < <(find "$BRAIN_DIR" -type f \( -name "*.json" -o -name "*.yml" -o -name "*.yaml" -o -name "*.sh" -o -name "*.py" -o -name "*.js" \) -print0 2>/dev/null)
[ $found -eq 0 ] && log_ok "No hardcoded paths found"

# Check 2: Duplicate function names
section "2. Duplicate Code Check"
duplicates=$(find "$BRAIN_DIR/scripts" -name "*.sh" -exec grep -h "^[a-zA-Z_][a-zA-Z0-9_]*()" {} \; 2>/dev/null | sort | uniq -d)
if [ -n "$duplicates" ]; then
    log_warn "Duplicate function names found"
    echo "$duplicates"
else
    log_ok "No duplicate function names"
fi

# Check 3: Uncommitted changes
section "3. Repository Status"
if [ -d "$BRAIN_DIR/.git" ]; then
    uncommitted=$(git -C "$BRAIN_DIR" status --porcelain 2>/dev/null)
    if [ -n "$uncommitted" ]; then
        log_warn "Uncommitted changes:"
        echo "$uncommitted" | head -10
    else
        log_ok "Working directory clean"
    fi
fi

# Check 4: Empty files
section "4. File Quality Check"
empty_count=0
while IFS= read -r file; do
    if [ ! -s "$file" ]; then
        [ $empty_count -lt 3 ] && log_warn "Empty file: $file"
        ((empty_count++))
    fi
done < <(find "$BRAIN_DIR" -type f \( -name "*.md" -o -name "*.sh" -o -name "*.py" \) ! -path "*/.git/*" 2>/dev/null)
[ $empty_count -eq 0 ] && log_ok "No empty files found"

# Summary
echo ""
echo -e "${BOLD}Audit Summary${RESET} - Errors: $ERRORS, Warnings: $WARNINGS"
[ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ] && log_ok "All checks passed!"
exit $((ERRORS > 0 ? 1 : 0))
